{
  "manifest_version": 3,
  "name": "Glance: image descriptions for screen readers",
  "short_name": "Glance",
  "version": "1.0.0",
  "description": "Describes unlabeled images for blind and low-vision users with on-device Gemini Nano, using cloud Gemini only when a page is public.",
  "minimum_chrome_version": "139",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Glance (Alt+Shift+G)", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Open Glance"
    },
    "describe-focused": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Describe the focused or hovered image in detail"
    }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
